# microservice specific routes

POST    /monthly/:zReference/reconciliation                                                       uk.gov.hmrc.disareturnsstubs.controllers.GenerateReportController.create(zReference: String)

PUT     /reporting-window-override/:zReference                                                    uk.gov.hmrc.disareturnsstubs.controllers.ReportingWindowOverrideController.set(zReference: String)

## ETMP routes

GET     /etmp/check-obligation-status/:zReference                                                 uk.gov.hmrc.disareturnsstubs.controllers.EtmpController.checkReturnsObligationStatus(zReference: String)

GET     /etmp/check-reporting-window                                                              uk.gov.hmrc.disareturnsstubs.controllers.EtmpController.checkReportingWindowStatus()

POST    /etmp/reporting-window-state                                                              uk.gov.hmrc.disareturnsstubs.controllers.EtmpSetupController.setReportingWindowState()

GET     /etmp/reporting-window-state                                                              uk.gov.hmrc.disareturnsstubs.controllers.EtmpSetupController.getReportingWindowState()

POST    /etmp/open-obligation-status/:zReference                                                  uk.gov.hmrc.disareturnsstubs.controllers.EtmpSetupController.openObligationStatus(zReference: String)

POST    /etmp/declaration/:zReference                                                             uk.gov.hmrc.disareturnsstubs.controllers.EtmpController.declare(zReference: String)

## NPS routes

POST    /nps/submit/:zReference                                                                   uk.gov.hmrc.disareturnsstubs.controllers.NpsController.submitMonthlyReturn(zReference: String)

POST    /nps/declaration/:zReference                                                              uk.gov.hmrc.disareturnsstubs.controllers.NpsController.send(zReference: String)

GET     /monthly/:zReference/:taxYear/:month/results                                              uk.gov.hmrc.disareturnsstubs.controllers.NpsController.getMonthlyReport(zReference: String, taxYear: String, month: String, pageIndex: Int, pageSize: Int)

## Upscan routes

POST    /upscan/v2/initiate                                                                       uk.gov.hmrc.disareturnsstubs.controllers.upscan.UpscanController.initiate()

POST    /upscan/upload                                                                            uk.gov.hmrc.disareturnsstubs.controllers.upscan.UpscanController.upload()

## Returns Submission routes

POST    /disa-returns-submission/monthly/:zReference/:taxYear/:month                              uk.gov.hmrc.disareturnsstubs.controllers.SubmissionsController.createReturn(zReference: String, taxYear: String, month: String)

PUT     /disa-returns-submission/monthly/:zReference/:taxYear/:month/submissions/:submissionId    uk.gov.hmrc.disareturnsstubs.controllers.SubmissionsController.storeSubmission(zReference: String, taxYear: String, month: String, submissionId: String)

POST    /disa-returns-submission/monthly/:zReference/:taxYear/:month/declarations                 uk.gov.hmrc.disareturnsstubs.controllers.SubmissionsController.declare(zReference: String, taxYear: String, month: String)

GET     /disa-returns-submission/reporting-window/status/:zReference                              uk.gov.hmrc.disareturnsstubs.controllers.ReportingWindowController.status(zReference: String)
